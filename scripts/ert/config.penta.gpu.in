# ERT configuration template for the pentadiagonal solver study.
#
# This is a TEMPLATE.  scripts/run_ert.sh substitutes the @...@ placeholders
# and writes the result next to the ERT results directory, so the exact config
# used by a run is always recoverable beside its output.
#
# Derived from ERT's own Config/config.cuda-fp64.corigpu.nersc.gov.01 (NVIDIA
# V100), with four deliberate changes:
#
#   1. -arch is filled in from the GPU actually present rather than pinned to
#      sm_70, so one template covers the GTX 1080 (sm_61) through the H100
#      (sm_90).
#   2. ERT_RUN drops srun.  Cori is a Slurm cluster; cobra and panda are not.
#      Override with ERT_RUN if a batch launcher is needed.
#   3. ERT_NUM_EXPERIMENTS stays at 1, as in Berkeley's own GPU configurations.
#      ERT already repeats trials internally at every working-set size, so the
#      few hundred milliseconds these cards need to reach boost clock are
#      absorbed without a second full pass.  Raising it multiplies the runtime
#      by the same factor, and one sweep already costs roughly five minutes per
#      flops/element value per precision.
#   4. The flops/element sweep is denser and reaches 1024.  The upper end
#      matters: an H100's memory/compute crossover sits near 385 flops per
#      element, so a sweep that stops earlier never reaches the point where the
#      compute roof becomes measurable at all.

ERT_RESULTS @RESULTS@

ERT_DRIVER  driver1
ERT_KERNEL  kernel1

ERT_GPU         True
ERT_GPU_CFLAGS  -x cu -arch=sm_@ARCH@
ERT_GPU_LDFLAGS

ERT_FLOPS   @FLOPS@
ERT_ALIGN   32

ERT_CC      nvcc
ERT_CFLAGS  -O3

ERT_LD      nvcc
ERT_LDFLAGS
ERT_LDLIBS

ERT_RUN     @RUN@

ERT_PRECISION @PRECISION@

ERT_BLOCKS_THREADS 163840
ERT_GPU_BLOCKS     160,320,640,1280,2560
ERT_GPU_THREADS    1024,512,256,128,64

ERT_NUM_EXPERIMENTS @EXPERIMENTS@

ERT_MEMORY_MAX @MEMORY_MAX@

ERT_WORKING_SET_MIN 128

ERT_TRIALS_MIN 1

ERT_GNUPLOT gnuplot
